# ==============================================================================
# Django Environment Variables & Cloudflare R2 Storage Configuration
# Copy this file to `backend/.env` and fill in your values
# ==============================================================================

# Core Django Configuration
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-before-launch
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (S3-Compatible)
# ------------------------------------------------------------------------------
# Set to 1 to enable Cloudflare R2 (auto-enabled when credentials are present)
CLOUDFLARE_R2_ENABLED=1

# 1. Cloudflare Account ID (found in Cloudflare dashboard URL or R2 overview)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id

# 2. R2 API Token credentials (generated in R2 > Manage R2 API Tokens > Object Read & Write)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 3. Your R2 Bucket Name (e.g., manus-car)
CLOUDFLARE_R2_BUCKET_NAME=manus-car

# 4. Public access domain (Optional but recommended):
# - Public R2.dev domain: pub-xxxxxxxxxxxxxxxx.r2.dev
# - Or your custom connected domain: cdn.yourdealership.com / media.yourdealership.com
# CLOUDFLARE_R2_CUSTOM_DOMAIN=pub-xxxxxxxxxxxxxxxx.r2.dev

# 5. URL signing:
# - Set to 1 if using direct S3 endpoint (allows browsers to load images securely via presigned links)
# - Set to 0 if you enabled public R2.dev domain or connected a custom domain
CLOUDFLARE_R2_QUERYSTRING_AUTH=1

# Google Identity Services: OAuth Web application client ID (no client secret).
GOOGLE_CLIENT_ID=
# Owner/admin phone alerts. Disabled until credentials and the scheduled job are configured.
SMS_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Production defaults redirect HTTP to HTTPS and set one-hour HSTS.
# Set only behind a trusted proxy that overwrites X-Forwarded-Proto:
DJANGO_TRUST_PROXY_HTTPS=0
